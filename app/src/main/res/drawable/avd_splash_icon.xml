<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_launcher_foreground_animatable">
    <target android:name="group_tl">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="translateX" android:valueFrom="-14" android:valueTo="0" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="translateY" android:valueFrom="-14" android:valueTo="0" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="group_tr">
        <aapt:attr name="android:animation">
            <set android:startOffset="60">
                <objectAnimator android:propertyName="translateX" android:valueFrom="14" android:valueTo="0" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="translateY" android:valueFrom="-14" android:valueTo="0" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="group_bl">
        <aapt:attr name="android:animation">
            <set android:startOffset="120">
                <objectAnimator android:propertyName="translateX" android:valueFrom="-14" android:valueTo="0" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="translateY" android:valueFrom="14" android:valueTo="0" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="group_br">
        <aapt:attr name="android:animation">
            <set android:startOffset="180">
                <objectAnimator android:propertyName="translateX" android:valueFrom="14" android:valueTo="0" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="translateY" android:valueFrom="14" android:valueTo="0" android:duration="450" android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
    <target android:name="group_page">
        <aapt:attr name="android:animation">
            <set android:startOffset="260">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.6" android:valueTo="1" android:duration="350" android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.6" android:valueTo="1" android:duration="350" android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
